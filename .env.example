DISCORD_TOKEN=your_discord_bot_token_here
YAPHUB_DATA_DIR=./data
# Optional explicit override:
# YAPHUB_DB_PATH=./data/yaphub.sqlite3

# Optional. Secret used to derive pseudonymous user/guild keys for usage
# telemetry (unique users/guilds served). Without it, room-count and
# reliability metrics still work; only unique-entity counts pause until
# it is set. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Do not rotate casually -- rotating it changes every pseudonymous key and
# resets lifetime-unique counts unless migrated intentionally. See
# services/telemetry.py and the README's Usage Telemetry section.
# YAPHUB_ANALYTICS_SECRET=
